Options -Indexes

# Protect application and development files from direct web access.
<FilesMatch "^(?:\.env(?:\..*)?|composer\.(?:json|lock)|phpunit\.xml(?:\.dist)?|README(?:\..*)?|.*\.sql|.*\.log)$">
    Require all denied
</FilesMatch>

# Prevent PHP execution in common upload locations.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?:uploads|storage/uploads|public/uploads)/.*\.(?:php[0-9]?|phtml|phar)$ - [F,L,NC]
</IfModule>

# Baseline security headers. HSTS is intentionally not enabled here because
# it must only be deployed after the site is confirmed HTTPS-only.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(self), camera=(self), microphone=()"
</IfModule>

# Redirect HTTP to HTTPS only when explicitly enabled by the hosting environment.
# Uncomment after confirming HTTPS is available on every production hostname:
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
